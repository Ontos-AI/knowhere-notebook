# Knowhere API key for document parsing and retrieval
KNOWHERE_API_KEY=sk_your_key_here

# Vercel AI Gateway key for chat (routes to DeepSeek and any other model by id)
AI_GATEWAY_API_KEY=vercel_your_key_here

# Optional override — defaults to deepseek/deepseek-v4-flash
# CHAT_MODEL=deepseek/deepseek-v4-flash
