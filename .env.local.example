# --- Knowhere (server-side only) ---
# Your Knowhere API key for document parsing and retrieval
KNOWHERE_API_KEY=sk_your_key_here

# Optional API base URL. Defaults to production when unset.
# Use staging when validating staging keys.
# KNOWHERE_BASE_URL=https://api-staging.knowhereto.ai

# --- Chat provider (server-side only) ---
# Vercel AI Gateway key; AI SDK picks it up automatically
AI_GATEWAY_API_KEY=vck_your_key_here

# Optional override — defaults to deepseek/deepseek-v4-flash
# CHAT_MODEL=deepseek/deepseek-v4-flash

# --- Auth (server-side only) ---
#
# Notebook and Dashboard share a parent domain so a single session cookie
# issued by Dashboard is sent by the browser on every request to Notebook.
#
# Production:   Dashboard = https://knowhereto.ai
#               Notebook  = https://notebook.knowhereto.ai
#               Shared parent = .knowhereto.ai
#
# Local dev:    Use /etc/hosts entries like
#                 127.0.0.1  dashboard.local.knowhereto.ai
#                 127.0.0.1  notebook.local.knowhereto.ai
#               so the cookie shares the local parent too.

# Dashboard oRPC session lookup endpoint.
#   prod:  https://knowhereto.ai/api/orpc/users/getCurrentUser
#   local: http://dashboard.local.knowhereto.ai:3000/api/orpc/users/getCurrentUser
DASHBOARD_SESSION_URL=http://dashboard.local.knowhereto.ai:3000/api/orpc/users/getCurrentUser

# Dashboard login page. Notebook redirects here with ?callbackURL=... when
# the user is not signed in. Dashboard's own sanitizer verifies that the
# callbackURL is an allowlisted Notebook origin before it honors the
# redirect (see knowhere-dashboard PR for the allowlist).
#   prod:  https://knowhereto.ai/login
#   local: http://dashboard.local.knowhereto.ai:3000/login
DASHBOARD_LOGIN_URL=http://dashboard.local.knowhereto.ai:3000/login

# Dashboard oRPC endpoint for obtaining a short-lived Knowhere JWT.
# Notebook forwards the Dashboard session cookie here; Dashboard signs a
# JWT with the user's id and returns it. Notebook passes the JWT directly
# to the Knowhere SDK as apiKey. No persistent API key is created.
#   prod:  https://knowhereto.ai/api/orpc/users/issueServiceJwt
#   local: http://dashboard.local.knowhereto.ai:3000/api/orpc/users/issueServiceJwt
DASHBOARD_KNOWHERE_TOKEN_URL=http://dashboard.local.knowhereto.ai:3000/api/orpc/users/issueServiceJwt

# Public URL of this Notebook deployment (used as `callbackURL`).
#   prod:  https://notebook.knowhereto.ai
#   local: http://notebook.local.knowhereto.ai:3001
NOTEBOOK_PUBLIC_URL=http://notebook.local.knowhereto.ai:3001

# Optional override of the session cookie names Dashboard sets. Defaults
# to Better Auth's standard cookie names.
# SESSION_COOKIE_NAMES=better-auth.session_token,__Secure-better-auth.session_token

# --- Database (server-side only) ---
# Neon Postgres connection string (Vercel Marketplace free tier).
# Provisioned by the owner; do not commit a real value.
DATABASE_URL=postgres://user:password@host/db

# Driver selection.
#   neon  (default) — @neondatabase/serverless (required for prod on Vercel/Neon)
#   pg             — postgres-js (use for local dev against a plain Postgres,
#                    or for AWS Aurora Postgres if/when we migrate off Neon)
DATABASE_DRIVER=pg
